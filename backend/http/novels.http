@baseUrl = http://localhost:3000/api/v1
@novelId = 1

### List all novels
GET {{baseUrl}}/novels

### Get novel by id
GET {{baseUrl}}/novels/{{novelId}}

### Get novel crawl/TTS stats
GET {{baseUrl}}/novels/{{novelId}}/stats

### Get playback position
GET {{baseUrl}}/novels/{{novelId}}/playback

### Update playback position
PUT {{baseUrl}}/novels/{{novelId}}/playback
Content-Type: application/json

{
  "chapterNumber": 1,
  "positionSec": 12.5
}

### Create novel
POST {{baseUrl}}/novels
Content-Type: application/json

{
  "url": "https://example.com/novel/1",
  "title": "My Novel",
  "author": "Author Name",
  "summary": "Short summary"
}

### Update novel
PUT {{baseUrl}}/novels/{{novelId}}
Content-Type: application/json

{
  "title": "Updated Title",
  "author": "New Author"
}

### Delete novel
DELETE {{baseUrl}}/novels/{{novelId}}
